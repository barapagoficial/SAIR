{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "void-style": ["error", { "style": "omit" }],
    "require-sri": "off",

    "element-required-attributes": "off",
    "prefer-native-element": "off",
    "autocomplete-password": "off",
    "hidden-focusable": "off"
  }
}
